# Normal local-desktop mode. Copy deliberately; never commit your .env.
MAILMIND_LOCAL_ONLY=false
MAILMIND_AUTO_MARK_READ=false
# Integrated-intelligence rollout flags. Keep user-visible and side-effecting
# features disabled until validation. Roll out collection, analytics/explanations,
# action extraction, dashboard reminders, then Telegram reminders in that order.
# Explicit saved-mail backfill becomes available with action extraction.
MAILMIND_ACTION_EXTRACTION_ENABLED=false
MAILMIND_ACTION_REMINDERS_ENABLED=false
MAILMIND_TELEGRAM_ACTION_REMINDERS_ENABLED=false
MAILMIND_TOKEN_COLLECTION_ENABLED=true
MAILMIND_TOKEN_ANALYTICS_VISIBLE=false
MAILMIND_EXPLANATIONS_VISIBLE=false
MAILMIND_DEFAULT_TIMEZONE=Asia/Kolkata
MAILMIND_WEEK_START=monday
# Check Gmail every 5 seconds by default. Keep this at 5 or higher.
# MAILMIND_POLL_INTERVAL_SECONDS=5
# MAILMIND_MAX_PENDING_TASKS=100
# MAILMIND_RESUME_PENDING_TASKS=50
# Cloud/Telegram are optional. Missing providers appear unconfigured.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional provider-model overrides (comma-separated Gemini failover order).
# MAILMIND_GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# (Gemini 3+ models are sent thinking_level=low. A retired or rejected model fails over
# to the next one; see docs/RESILIENCE.md.)
# Per-provider timeout in seconds (1-30); also bounds Telegram requests.
# MAILMIND_PROVIDER_TIMEOUT_SECONDS=5
# MAILMIND_GROQ_MODEL=openai/gpt-oss-20b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Models are not shipped in Git. Missing/incompatible assets show unavailable.
# MAILMIND_MODEL_PATH=/absolute/path/to/three-category-checkpoint
# Run the local model beside the cloud as a comparison-only shadow (it never decides).
# Off by default: no PyTorch process and no extra CPU per email. Local-only mode ignores this.
MAILMIND_SHADOW_MODEL_ENABLED=false
# Normal mode shadow-only checkpoint; it never replaces the cloud decision.
# MAILMIND_SHADOW_MODEL_PATH=/absolute/path/to/inbox-approved-v2
# For true offline startup set mode/manifest in the process environment first.
# MAILMIND_ASSET_MANIFEST=/absolute/path/to/manifest.json
# Local-only mode (MAILMIND_LOCAL_ONLY=true) loads a model ONLY with a verified manifest,
# and refuses to start with MAILMIND_TELEGRAM_ACTION_REMINDERS_ENABLED=true.
